{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Level 5: A Chirp Disaster\n",
    "\n",
    "This notebook finishes the workflow for the challenge: load the Level 5 input file, build repeated historical features, train a regressor for `Arrivals`, and generate the required top-50 BOP prediction file for Days 731-760.\n",
    "\n",
    "Expected file in Colab or local workspace:\n",
    "- `/content/in_level-5_1-main.txt`\n",
    "- or a local path you update below.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "from sklearn.ensemble import HistGradientBoostingRegressor\n",
    "from sklearn.model_selection import TimeSeriesSplit\n",
    "\n",
    "pd.set_option('display.max_columns', 20)\n",
    "\n",
    "# Update this if your file lives somewhere else.\n",
    "DATA_PATHS = [\n",
    "    '/content/in_level-5_1-main.txt',\n",
    "    './in_level-5_1-main.txt',\n",
    "    '/mnt/data/in_level-5_1-main.txt',\n",
    "]\n",
    "\n",
    "data_path = next((p for p in DATA_PATHS if os.path.exists(p)), DATA_PATHS[0])\n",
    "print(f'Using data file: {data_path}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the Level 5 CSV\n",
    "df = pd.read_csv(data_path)\n",
    "\n",
    "# Normalize the type for later modeling\n",
    "df['Arrivals'] = pd.to_numeric(df['Arrivals'], errors='coerce')\n",
    "df['Occupancy'] = pd.to_numeric(df['Occupancy'], errors='coerce')\n",
    "df['Wind X [m/s]'] = pd.to_numeric(df['Wind X [m/s]'], errors='coerce')\n",
    "df['Wind Y [m/s]'] = pd.to_numeric(df['Wind Y [m/s]'], errors='coerce')\n",
    "df['Insects Delta [g/m²]'] = pd.to_numeric(df['Insects Delta [g/m²]'], errors='coerce')\n",
    "\n",
    "# Make sure the full dataset is sorted by BOP and day for lag-based features\n",
    "df = df.sort_values(['BOP', 'Day']).reset_index(drop=True)\n",
    "\n",
    "print(df.head())\n",
    "print(f'Rows: {len(df)}')\n",
    "print(f'Days: {df[\'Day\'].min()} to {df[\'Day\'].max()}')\n",
    "print(f'NaN Arrivals: {df[\'Arrivals\'].isna().sum()}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- Feature engineering ---\n",
    "# Historical lag features by BOP. This keeps the model anchored to each BOP's own trend and seasonality.\n",
    "grouped = df.groupby('BOP', sort=False)\n",
    "\n",
    "for lag in [1, 2, 3, 7, 14, 30]:\n",
    "    df[f'arrivals_lag_{lag}'] = grouped['Arrivals'].shift(lag)\n",
    "    df[f'occupancy_lag_{lag}'] = grouped['Occupancy'].shift(lag)\n",
    "    df[f'windx_lag_{lag}'] = grouped['Wind X [m/s]'].shift(lag)\n",
    "    df[f'windy_lag_{lag}'] = grouped['Wind Y [m/s]'].shift(lag)\n",
    "    df[f'insects_lag_{lag}'] = grouped['Insects Delta [g/m²]'].shift(lag)\n",
    "\n",
    "    df[f'arrivals_rolling_mean_{lag}'] = (\n",
    "        grouped['Arrivals'].transform(lambda s: s.shift(1).rolling(window=lag, min_periods=1).mean())\n",
    "    )\n",
    "\n",
    "# BOP-level aggregate statistics\n",
    "df['bop_arrivals_mean'] = grouped['Arrivals'].transform('mean')\n",
    "df['bop_arrivals_std'] = grouped['Arrivals'].transform('std').fillna(0)\n",
    "df['bop_occupancy_mean'] = grouped['Occupancy'].transform('mean')\n",
    "\n",
    "# Day cycle helps capture recurring seasonal patterns\n",
    "df['day_sin'] = np.sin(2 * np.pi * df['Day'] / 365.25)\n",
    "df['day_cos'] = np.cos(2 * np.pi * df['Day'] / 365.25)\n",
    "\n",
    "# Trend/relative features\n",
    "df['occupancy_ratio'] = df['Occupancy'] / (df['bop_occupancy_mean'] + 1e-6)\n",
    "df['arrivals_gap_1'] = df['Arrivals'] - df['arrivals_lag_1']\n",
    "\n",
    "# Fill missing values created by shifts at the beginning of each series\n",
    "feature_cols = [\n",
    "    'Day', 'BOP', 'Occupancy', 'Wind X [m/s]', 'Wind Y [m/s]', 'Insects Delta [g/m²]',\n",
    "    'arrivals_lag_1', 'arrivals_lag_2', 'arrivals_lag_3', 'arrivals_lag_7', 'arrivals_lag_14', 'arrivals_lag_30',\n",
    "    'occupancy_lag_1', 'occupancy_lag_2', 'occupancy_lag_3', 'occupancy_lag_7', 'occupancy_lag_14', 'occupancy_lag_30',\n",
    "    'arrivals_rolling_mean_7', 'arrivals_rolling_mean_14', 'arrivals_rolling_mean_30',\n",
    "    'bop_arrivals_mean', 'bop_arrivals_std', 'bop_occupancy_mean',\n",
    "    'day_sin', 'day_cos', 'occupancy_ratio', 'arrivals_gap_1'\n",
    "]\n",
    "\n",
    "df[feature_cols] = df[feature_cols].fillna(method='ffill').fillna(method='bfill')\n",
    "df[feature_cols] = df[feature_cols].apply(pd.to_numeric, errors='coerce').fillna(0.0)\n",
    "\n",
    "print('Feature columns ready:', len(feature_cols))\n",
    "print(df[feature_cols].head())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train/validation split using time ordering.\n",
    "# We keep the final 30-day window as our validation set, which mirrors the competition setting.\n",
    "train_mask = df['Day'] <= 700\n",
    "valid_mask = (df['Day'] > 700) & (df['Day'] <= 730)\n",
    "\n",
    "train_df = df[train_mask & df['Arrivals'].notna()].copy()\n",
    "valid_df = df[valid_mask & df['Arrivals'].notna()].copy()\n",
    "\n",
    "X_train = train_df[feature_cols]\n",
    "y_train = train_df['Arrivals']\n",
    "X_valid = valid_df[feature_cols]\n",
    "y_valid = valid_df['Arrivals']\n",
    "\n",
    "model = HistGradientBoostingRegressor(\n",
    "    learning_rate=0.05,\n",
    "    max_depth=12,\n",
    "    max_iter=300,\n",
    "    min_samples_leaf=20,\n",
    "    random_state=42,\n",
    ")\n",
    "\n",
    "model.fit(X_train, y_train)\n",
    "\n",
    "valid_pred = model.predict(X_valid)\n",
    "valid_mae = np.mean(np.abs(valid_pred - y_valid))\n",
    "valid_rmse = np.sqrt(np.mean((valid_pred - y_valid) ** 2))\n",
    "\n",
    "print(f'Validation MAE: {valid_mae:.2f}')\n",
    "print(f'Validation RMSE: {valid_rmse:.2f}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate predictions for the target window Days 731-760.\n",
    "# The raw file contains the weather + occupancy for these days, but the Arrivals values are missing.\n",
    "output_df = df[df['Day'] >= 731].copy()\n",
    "\n",
    "# Reuse the same feature set, now with the test-day observations.\n",
    "pred = model.predict(output_df[feature_cols])\n",
    "output_df['Predicted_Arrivals'] = pred\n",
    "\n",
    "# Keep only the columns we need for the submission.\n",
    "print(output_df[['Day', 'BOP', 'Predicted_Arrivals']].head())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Build the required format: a row per day, with the top 50 BOP IDs sorted by predicted arrivals.\n",
    "submission_rows = ['Day,Top 50 Arrivals BOPs']\n",
    "\n",
    "for day in range(731, 761):\n",
    "    day_df = output_df[output_df['Day'] == day].sort_values('Predicted_Arrivals', ascending=False).head(50)\n",
    "    bop_list = ' '.join(str(int(bop)) for bop in day_df['BOP'].tolist())\n",
    "    submission_rows.append(f'{day},{bop_list}')\n",
    "\n",
    "submission_path = 'submission_level_5.csv'\n",
    "with open(submission_path, 'w') as f:\n",
    "    f.write('\n'.join(submission_rows) + '\n')\n",
    "\n",
    "print(f'Wrote submission to: {submission_path}')\n",
    "print('\n'.join(submission_rows[:6]))\n"
   ]
  },
  { 
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Notes\n",
    "- This is a strong baseline, not the final optimized model.\n",
    "- For a stronger submission, try XGBoost / LightGBM with richer feature interactions, or a per-BOP seasonal model.\n",
    "- The challenge wants the top 50 BOPs with the highest predicted arrival counts for Days 731-760.\n"
   ]
  }
 ],
